{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacs-agent-template:reference-json-transform:output:1",
  "title": "Reference JSON Transform Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceMode", "missing", "selected", "seed"],
  "properties": {
    "evidenceMode": { "const": "fixture" },
    "missing": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "selected": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "minLength": 1, "maxLength": 128 },
      "additionalProperties": { "type": "string", "maxLength": 4096 }
    },
    "seed": { "type": "string", "minLength": 1, "maxLength": 4096 }
  }
}
