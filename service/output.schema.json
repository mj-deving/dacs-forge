{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacs-forge:attested-public-data:output:1",
  "title": "Attested Public Data Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceMode", "fixtureSet", "datasetId", "sourceDescriptors", "observations", "availability", "limitations"],
  "$defs": {
    "metric": { "enum": ["no2", "pm10", "pm25"] },
    "stationId": { "type": "string", "pattern": "^[A-Z0-9]{3,16}$" }
  },
  "properties": {
    "evidenceMode": { "const": "fixture" },
    "fixtureSet": { "type": "string", "minLength": 1, "maxLength": 128 },
    "datasetId": { "const": "berlin-air-quality-hourly" },
    "sourceDescriptors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "fixtureLocator", "publisher", "capturedAt"],
        "properties": {
          "sourceId": { "const": "berlin-open-data-air-quality" },
          "fixtureLocator": { "type": "string", "pattern": "^fixture://", "maxLength": 512 },
          "publisher": { "const": "Berlin Open Data fixture" },
          "capturedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stationId", "metric", "value", "unit", "observedAt", "sourceId", "contentHash"],
        "properties": {
          "stationId": { "$ref": "#/$defs/stationId" },
          "metric": { "$ref": "#/$defs/metric" },
          "value": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "maxLength": 32 },
          "unit": { "const": "ug/m3" },
          "observedAt": { "type": "string", "format": "date-time" },
          "sourceId": { "const": "berlin-open-data-air-quality" },
          "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "availability": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stationId", "metric", "status"],
        "properties": {
          "stationId": { "$ref": "#/$defs/stationId" },
          "metric": { "$ref": "#/$defs/metric" },
          "status": { "enum": ["available", "not-found"] }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "text"],
        "properties": {
          "code": { "enum": ["fixture-only", "not-live", "no-source-truth", "not-safety-critical"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
