{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacs-forge:attested-public-data:input:1",
  "title": "Attested Public Data Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasetId", "stationIds", "metrics"],
  "properties": {
    "datasetId": { "const": "berlin-air-quality-hourly" },
    "stationIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z0-9]{3,16}$" }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["no2", "pm10", "pm25"] }
    }
  }
}
