{
  "name": "dacs-forge",
  "version": "0.0.0-private",
  "description": "Deterministic no-spend DACS service and conformance substrate for extension-only service implementations.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mj-deving/dacs-forge.git"
  },
  "bugs": {
    "url": "https://github.com/mj-deving/dacs-forge/issues"
  },
  "homepage": "https://github.com/mj-deving/dacs-forge#readme",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": "1.3.9"
  },
  "overrides": {
    "fast-uri": "3.1.4"
  },
  "bin": {
    "dacs": "./src/cli/dacs.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --packages external",
    "check": "bun run verify:provenance && bun run typecheck && bun test",
    "container:self-test": "bun run ./scripts/container-fixture-runtime.ts self-test",
    "container:serve": "bun run ./scripts/container-fixture-runtime.ts serve",
    "container:supply-chain": "mkdir -p dist/container-supply-chain && docker build --pull --no-cache --provenance=mode=min --metadata-file dist/container-supply-chain/build-metadata.json --tag dacs-forge:supply-chain-candidate . && bun run ./scripts/container-supply-chain.ts qualify --image dacs-forge:supply-chain-candidate --output dist/container-supply-chain",
    "mutation:calibrate": "bun scripts/calibrate-mutation-runner.ts --calibration-only",
    "mutation:check": "bun scripts/calibrate-mutation-runner.ts",
    "test": "bun test --timeout 10000",
    "typecheck": "tsc --noEmit",
    "verify:container": "bun run ./scripts/verify-container-fixture.ts",
    "verify:dockerfile-bases": "bun run ./scripts/lint-dockerfile-bases.ts",
    "verify:provenance": "bun tools/verify-source-provenance.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@types/bun": "1.3.14",
    "fast-check": "4.9.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
